{
  // LP First Stats — Cloudflare Worker
  // Setup:
  //   npx wrangler d1 create lpfirst-stats   -> paste database_id below
  //   npx wrangler secret put BETTER_AUTH_SECRET   (openssl rand -hex 32)
  //   npx wrangler secret put INGEST_TOKEN         (openssl rand -hex 32; also add as GH secret)
  //   npx wrangler secret put RESEND_API_KEY       (optional, for invitation emails)
  "name": "lpfirst-stats",
  "main": "src/index.tsx",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Pages are server-rendered by the Worker; public/ only holds static
    // assets (images etc.), served via the catch-all ASSETS fallback route.
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lpfirst-stats",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  // Nightly Albi sync (after the 6:00 UTC scrape workflow window).
  "triggers": {
    "crons": ["30 7 * * *"]
  },
  "vars": {
    // Set to the deployed URL (workers.dev or custom domain). Must match what
    // MCP clients and browsers use — OAuth issuer/redirects derive from it.
    "BASE_URL": "https://lpfirst-stats.YOUR_SUBDOMAIN.workers.dev",
    "INVITE_FROM_EMAIL": "stats@lpfirst.com"
  }
}
